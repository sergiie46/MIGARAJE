<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vehicle_photos/" />
        <!-- No respaldar cachés/bases locales (incluida la caché offline de Firestore). -->
        <exclude domain="database" path="." />
    </cloud-backup>

    <device-transfer>
        <!-- Evita transferir cachés/bases locales obsoletas entre dispositivos. -->
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
